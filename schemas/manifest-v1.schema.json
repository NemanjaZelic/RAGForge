{
  "$defs": {
    "BuildConfiguration": {
      "additionalProperties": false,
      "properties": {
        "chunk_size_chars": {
          "minimum": 1,
          "title": "Chunk Size Chars",
          "type": "integer"
        },
        "chunker_version": {
          "minLength": 1,
          "title": "Chunker Version",
          "type": "string"
        },
        "overlap_chars": {
          "minimum": 0,
          "title": "Overlap Chars",
          "type": "integer"
        },
        "parser_version": {
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "pdf_options": {
          "anyOf": [
            {
              "$ref": "#/$defs/PdfOptions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "parser_version",
        "chunker_version",
        "chunk_size_chars",
        "overlap_chars"
      ],
      "title": "BuildConfiguration",
      "type": "object"
    },
    "CollectionManifest": {
      "additionalProperties": false,
      "properties": {
        "collection_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Collection Id",
          "type": "string"
        },
        "database_path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\\\:\\x00-\\x1f<>\"|?*]+$",
          "title": "Database Path",
          "type": "string"
        },
        "dense_index": {
          "anyOf": [
            {
              "$ref": "#/$defs/DenseIndex"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "documents": {
          "items": {
            "$ref": "#/$defs/DocumentRecord"
          },
          "maxItems": 100000,
          "minItems": 1,
          "title": "Documents",
          "type": "array"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "collection_id",
        "title",
        "database_path",
        "documents"
      ],
      "title": "CollectionManifest",
      "type": "object"
    },
    "DenseIndex": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "minLength": 1,
          "title": "Backend",
          "type": "string"
        },
        "backend_version": {
          "minLength": 1,
          "title": "Backend Version",
          "type": "string"
        },
        "dimensions": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Dimensions",
          "type": "integer"
        },
        "metric": {
          "enum": [
            "cosine",
            "dot",
            "l2"
          ],
          "title": "Metric",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\\\:\\x00-\\x1f<>\"|?*]+$",
          "title": "Path",
          "type": "string"
        },
        "source_chunks": {
          "anyOf": [
            {
              "$ref": "#/$defs/DenseSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "path",
        "backend",
        "backend_version",
        "dimensions",
        "metric"
      ],
      "title": "DenseIndex",
      "type": "object"
    },
    "DenseSource": {
      "additionalProperties": false,
      "properties": {
        "build_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Build Id",
          "type": "string"
        },
        "database_path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\\\:\\x00-\\x1f<>\"|?*]+$",
          "title": "Database Path",
          "type": "string"
        },
        "mapping_version": {
          "const": "text-overlap-v1",
          "default": "text-overlap-v1",
          "title": "Mapping Version",
          "type": "string"
        }
      },
      "required": [
        "database_path",
        "build_id"
      ],
      "title": "DenseSource",
      "type": "object"
    },
    "DocumentRecord": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "document_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Document Id",
          "type": "string"
        },
        "source_path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\\\:\\x00-\\x1f<>\"|?*]+$",
          "title": "Source Path",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "document_id",
        "source_path",
        "content_sha256"
      ],
      "title": "DocumentRecord",
      "type": "object"
    },
    "FileRecord": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\\\:\\x00-\\x1f<>\"|?*]+$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "FileRecord",
      "type": "object"
    },
    "PdfOptions": {
      "additionalProperties": false,
      "properties": {
        "allow_partial": {
          "default": false,
          "title": "Allow Partial",
          "type": "boolean"
        },
        "max_document_stream_bytes": {
          "default": 67108864,
          "minimum": 1,
          "title": "Max Document Stream Bytes",
          "type": "integer"
        },
        "max_page_text_chars": {
          "default": 200000,
          "minimum": 1,
          "title": "Max Page Text Chars",
          "type": "integer"
        },
        "max_pages": {
          "default": 500,
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        },
        "max_stream_bytes": {
          "default": 8388608,
          "minimum": 1,
          "title": "Max Stream Bytes",
          "type": "integer"
        },
        "max_stream_operations": {
          "default": 500000,
          "minimum": 1,
          "title": "Max Stream Operations",
          "type": "integer"
        },
        "max_text_chars": {
          "default": 2000000,
          "minimum": 1,
          "title": "Max Text Chars",
          "type": "integer"
        }
      },
      "title": "PdfOptions",
      "type": "object"
    },
    "QueryModel": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Dimensions",
          "type": "integer"
        },
        "files": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[^\\\\:\\x00-\\x1f<>\"|?*]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "runtime": {
          "minLength": 1,
          "title": "Runtime",
          "type": "string"
        },
        "runtime_version": {
          "minLength": 1,
          "title": "Runtime Version",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "revision",
        "runtime",
        "runtime_version",
        "dimensions",
        "files",
        "license"
      ],
      "title": "QueryModel",
      "type": "object"
    },
    "RerankerModel": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[^\\\\:\\x00-\\x1f<>\"|?*]+$",
            "type": "string"
          },
          "minItems": 4,
          "title": "Files",
          "type": "array"
        },
        "license": {
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "runtime": {
          "const": "onnxruntime-cpu",
          "default": "onnxruntime-cpu",
          "title": "Runtime",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "revision",
        "files",
        "license"
      ],
      "title": "RerankerModel",
      "type": "object"
    },
    "RetrievalConfiguration": {
      "additionalProperties": false,
      "properties": {
        "candidates_per_method": {
          "default": 100,
          "maximum": 200,
          "minimum": 50,
          "title": "Candidates Per Method",
          "type": "integer"
        },
        "max_chunks_per_document": {
          "anyOf": [
            {
              "maximum": 50,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Chunks Per Document"
        },
        "query_aliases": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^[^\\\\:\\x00-\\x1f<>\"|?*]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Aliases"
        },
        "query_planning": {
          "anyOf": [
            {
              "enum": [
                "facets-v1",
                "facets-v2"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Planning"
        },
        "reranker": {
          "$ref": "#/$defs/RerankerModel"
        },
        "section_context": {
          "anyOf": [
            {
              "enum": [
                "section-start-v1",
                "section-start-v2"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Context"
        },
        "version": {
          "const": "candidate-rerank-v1",
          "default": "candidate-rerank-v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "reranker"
      ],
      "title": "RetrievalConfiguration",
      "type": "object"
    },
    "RuntimeRequirements": {
      "additionalProperties": false,
      "properties": {
        "adapters": {
          "items": {
            "const": "cli",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Adapters",
          "type": "array"
        },
        "python_min": {
          "const": "3.11",
          "title": "Python Min",
          "type": "string"
        },
        "requires_fts5": {
          "const": true,
          "title": "Requires Fts5",
          "type": "boolean"
        }
      },
      "required": [
        "python_min",
        "requires_fts5",
        "adapters"
      ],
      "title": "RuntimeRequirements",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_schema_version": {
      "const": "1",
      "title": "Artifact Schema Version",
      "type": "string"
    },
    "build_configuration": {
      "$ref": "#/$defs/BuildConfiguration"
    },
    "build_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Build Id",
      "type": "string"
    },
    "capabilities": {
      "default": [
        "bm25"
      ],
      "items": {
        "enum": [
          "bm25",
          "dense",
          "hybrid"
        ],
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Capabilities",
      "type": "array"
    },
    "collections": {
      "items": {
        "$ref": "#/$defs/CollectionManifest"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Collections",
      "type": "array"
    },
    "default_search_method": {
      "default": "bm25",
      "enum": [
        "bm25",
        "dense",
        "hybrid"
      ],
      "title": "Default Search Method",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/FileRecord"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "index_backend": {
      "const": "sqlite-fts5",
      "title": "Index Backend",
      "type": "string"
    },
    "index_schema_version": {
      "const": 1,
      "title": "Index Schema Version",
      "type": "integer"
    },
    "licenses": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Licenses",
      "type": "array"
    },
    "producer_version": {
      "minLength": 1,
      "title": "Producer Version",
      "type": "string"
    },
    "profile": {
      "enum": [
        "minimal",
        "balanced"
      ],
      "title": "Profile",
      "type": "string"
    },
    "query_model": {
      "anyOf": [
        {
          "$ref": "#/$defs/QueryModel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "retrieval_configuration": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetrievalConfiguration"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runtime": {
      "$ref": "#/$defs/RuntimeRequirements"
    },
    "sqlite_build_version": {
      "minLength": 1,
      "title": "Sqlite Build Version",
      "type": "string"
    }
  },
  "required": [
    "artifact_schema_version",
    "build_id",
    "producer_version",
    "profile",
    "index_backend",
    "index_schema_version",
    "sqlite_build_version",
    "collections",
    "files",
    "build_configuration",
    "runtime",
    "licenses"
  ],
  "title": "BundleManifest",
  "type": "object"
}
