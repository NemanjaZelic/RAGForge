{
  "$defs": {
    "WebSource": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "source_path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\\\:\\x00-\\x1f<>\"|?*]+$",
          "title": "Source Path",
          "type": "string"
        },
        "url": {
          "maxLength": 4096,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "url",
        "content_sha256",
        "raw_sha256",
        "media_type"
      ],
      "title": "WebSource",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "fetched_at": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Fetched At",
      "type": "string"
    },
    "format_version": {
      "const": "1",
      "default": "1",
      "title": "Format Version",
      "type": "string"
    },
    "issues": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "title": "Issues",
      "type": "array"
    },
    "max_depth": {
      "maximum": 10,
      "minimum": 0,
      "title": "Max Depth",
      "type": "integer"
    },
    "max_pages": {
      "maximum": 1000,
      "minimum": 1,
      "title": "Max Pages",
      "type": "integer"
    },
    "seed_url": {
      "maxLength": 4096,
      "title": "Seed Url",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/WebSource"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "seed_url",
    "fetched_at",
    "max_pages",
    "max_depth",
    "complete",
    "sources"
  ],
  "title": "WebSources",
  "type": "object"
}
